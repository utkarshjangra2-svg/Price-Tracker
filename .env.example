# Database
MONGODB_URI=mongodb://localhost:27017/price-optimizer

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# Zomato MCP Configuration
ZOMATO_MCP_OFFICIAL_URL=https://mcp-server.zomato.com/mcp
ZOMATO_MCP_BEARER_TOKEN=your_zomato_bearer_token_here

# Swiggy OAuth Configuration (REQUIRED for Swiggy Auth)
SWIGGY_OAUTH_CLIENT_ID=your_swiggy_client_id_here
SWIGGY_OAUTH_CLIENT_SECRET=your_swiggy_client_secret_here
SWIGGY_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/swiggy/callback

# Swiggy Food MCP Configuration
SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_FOOD_MCP_TIMEOUT_MS=15000

# Optional: Swiggy MCP Bearer Token (if required by Swiggy)
SWIGGY_MCP_BEARER_TOKEN=your_swiggy_mcp_bearer_token_here

# Email Configuration (for password resets)
EMAIL_SERVICE_PROVIDER=gmail
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
RESET_URL=https://your-domain.com/reset-password

# Server
PORT=3000
NODE_ENV=development
